# Gemini (existing)
GEMINI_API_KEY=
# or:
# VITE_GEMINI_API_KEY=

# Firebase Web App config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: pre-seeded Vizier admin for DEV only (must exist in Firebase Auth
# or will be created on first "Vizier Entrance" click in development)
VITE_VIZIER_EMAIL=vizier@ysi.local
VITE_VIZIER_PASSWORD=ChangeMe_Vizier_Dev_Only
